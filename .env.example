OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_A=deepseek/deepseek-v3.2

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Optional, only for a model supporting this parameter.
OPENAI_REASONING_EFFORT=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
# Optional, only for a model supporting this parameter.
GEMINI_THINKING_LEVEL=

EDENAI_API_KEY=
EDENAI_BASE_URL=https://api.edenai.run/v3/llm

# Three attempts in total, with delays of 2 and 4 seconds; timeout per attempt.
LLM_TIMEOUT_SECONDS=120
JUDGE_SEMAPHORE=4

# Default: OpenAI, Anthropic and Gemini. Alternatively repeat one provider/model.
USE_SINGLE_JUDGE_PROVIDER=false
SINGLE_JUDGE_PROVIDER=openrouter
SINGLE_JUDGE_MODEL=deepseek/deepseek-v3.2

# Optional explicit panel: uncomment ALL six lines together.
# Cannot be combined with USE_SINGLE_JUDGE_PROVIDER=true.
# JUDGE_1_PROVIDER=openai
# JUDGE_1_MODEL=gpt-4o
# JUDGE_2_PROVIDER=anthropic
# JUDGE_2_MODEL=claude-3-5-sonnet-latest
# JUDGE_3_PROVIDER=gemini
# JUDGE_3_MODEL=gemini-1.5-pro

# Retained generation/state settings; CLI batch concurrency uses --workers.
BATCH_SIZE=40
GEN_SEMAPHORE=28
REDIS_HOST=localhost
REDIS_PORT=6379

# Paths are resolved from the repository root. Historical inputs stay separate.
INPUT_FILE=data/atomic_dataset/v4_atomic_all_agg.csv
OUTPUT_FILE=experiments/events/results/forensic_atomic_final.csv
JUDGEMENT_FILE=experiments/events/results/tribunal_judgments_new.csv
